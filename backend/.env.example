NODE_ENV=development
PORT=5000
MONGODB_URI=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Get a free key at https://aistudio.google.com/app/apikey
# Leave blank to run with the deterministic mock AI provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional override: "gemini" | "mock". Auto-detected from GEMINI_API_KEY if omitted.
AI_PROVIDER=